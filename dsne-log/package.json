{
  "name": "dsne-logistique",
  "version": "1.0.0",
  "description": "DSNE — Logistique",
  "main": "main.js",
  "author": "DSNE",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "ht.gouv.mspp.dsne.log",
    "productName": "DSNE Logistique",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/log.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
