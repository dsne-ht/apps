{
  "name": "dsne-hygiene-publique",
  "version": "1.0.0",
  "description": "DSNE – Certificat d'Hygiene Publique",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "ht.gouv.mspp.dsne.hyg",
    "productName": "DSNE Hygiene Publique",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ],
    "electronVersion": "28.3.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3"
  },
  "author": "DSNE"
}
