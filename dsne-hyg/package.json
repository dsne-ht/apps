{
  "name": "dsne-hygiene-publique",
  "version": "1.9.0",
  "description": "DSNE — Certificats Hygiene Publique",
  "main": "main.js",
  "author": "DSNE",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "ht.gouv.mspp.dsne.hyg",
    "productName": "DSNE Hygiene Publique",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/hp.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3"
  }
}