{
  "name": "dsne-accueil",
  "version": "1.9.0",
  "description": "DSNE — Enregistrement des Visiteurs (PROC-004)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "ht.dsne.accueil",
    "productName": "DSNE Accueil",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/vs.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "googleapis": "^140.0.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}