{
  "name": "dsne-bureau",
  "version": "2.0.1",
  "description": "Bureau de Direction — DSNE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "ht.dsne.bureau",
    "productName": "Bureau de Direction DSNE",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dsne-ht",
        "repo": "apps"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/cm.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "files": [
      "main.js",
      "index.html",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}